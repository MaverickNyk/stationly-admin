# ─────────────────────────────────────────────────────────────────────────
# Stationly Admin Console — environment template (the only example file)
# Copy to `.env.local` for local dev, or to `.env` on a VM, then fill in.
# NEVER commit a real env file. Config is FLAT: each deployment carries only
# its own environment's values — the file that's present IS the environment.
# ─────────────────────────────────────────────────────────────────────────

# The single explicit marker — drives the safety banner/tone.
#   staging     → targets staging, shows the orange "⚠ STAGING" banner
#   production  → targets prod, no banner (prod must be opt-in)
# Use `staging` for local dev.
STATIONLY_ENV=staging

# Console login gate + cookie-signing secret (openssl rand -hex 32).
ADMIN_PASSWORD=
SESSION_SECRET=

# Backend this console targets. Defaults if omitted:
#   staging → https://staging-api.stationly.co.uk
#   prod    → https://api.stationly.co.uk
#   local   → point at a local backend, e.g. http://localhost:3000
BACKEND_URL=https://staging-api.stationly.co.uk

# MUST equal the backend's STATIONLY_ADMIN_KEY for the same environment.
ADMIN_KEY=

# Cloudflare Access service token — ONLY if the backend's /admin/* API is gated
# behind Cloudflare Access. Leave blank otherwise.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ── Health dashboard (/health) ──────────────────────────────────────────────
# The PUBLIC client key (X-Stationly-Key) so the health checks can probe the
# app-facing /api/v1/* surface exactly as the app does. If unset, the app-surface
# probes are reported as "skipped" (liveness + admin checks still run).
STATIONLY_API_KEY=

# Public StationUI website to ping. Defaults if omitted:
#   staging → https://staging.stationly.co.uk
#   prod    → https://stationly.co.uk
WEBSITE_URL=https://staging.stationly.co.uk

# STAGING ONLY: the staging website is behind HTTP Basic auth — set "user:pass"
# so the health probe can authenticate (else it reports 401/degraded). Ignored
# unless STATIONLY_ENV=staging, so production is never sent credentials.
WEBSITE_BASIC_AUTH=

# Optional tuning (sensible defaults shown).
HEALTHCHECK_INTERVAL_MS=300000        # how often the scheduler runs a full cycle (5 min)
HEALTHCHECK_TIMEOUT_MS=10000          # per-probe timeout
HEALTHCHECK_HISTORY=288               # results retained per check (24h @ 5min)
HEALTHCHECK_SEARCH=king               # sample searchKey for /stations/search
HEALTHCHECK_LATLON=51.5074,-0.1278    # sample lat,lon for /stations/nearby
HEALTHCHECK_SLOW_MS=2500              # an "up" probe slower than this ⇒ degraded (slow)
HEALTHCHECK_TLS_WARN_DAYS=14          # TLS cert within this many days of expiry ⇒ degraded
HEALTHCHECK_SYNCER_STALE_MS=86400000  # no line-status change in this long ⇒ syncer degraded (24h)

# ── Syncer status API (direct probe) ────────────────────────────────────────
# StationlySyncer now exposes /health + /sync-status. When SYNCER_URL is set, the
# dashboard's "Syncer" check probes it DIRECTLY (the row is clickable for the full
# last-run breakdown); when unset it falls back to inferring syncer health from
# backend data freshness (the old behaviour) — so this is safe to leave blank.
#
# NOTE: this console runs in Docker but the Syncer runs on the host (systemd,
# bound to 127.0.0.1:8081), so 127.0.0.1 from inside the container is the WRONG
# host. Use the host gateway: in docker-compose add
#     extra_hosts: ["host.docker.internal:host-gateway"]
# set the Syncer to bind SYNCER_STATUS_BIND=0.0.0.0 + a SYNCER_STATUS_KEY, then:
SYNCER_URL=                            # e.g. http://host.docker.internal:8081  (blank ⇒ infer)
SYNCER_STATUS_KEY=                     # must equal the Syncer's syncer.status.key (if it set one)

# Alerting — POST a message to a webhook (Slack/Discord/generic {text}) when a
# check changes state. Off if the webhook is unset. By default alerts on outages
# + recovery; set ON_DEGRADED=1 to also alert on degraded.
HEALTH_ALERT_WEBHOOK=
HEALTH_ALERT_ON_DEGRADED=
